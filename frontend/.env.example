# ---- API ----------------------------------------------------------------------
# Base URL of the Fastify backend (the real API).
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3001
# Realtime notifications socket (backend notification hub). Defaults to the API URL.
NEXT_PUBLIC_SOCKET_URL=

# ---- Payments ------------------------------------------------------------------
# Publishable key matching the backend PAYMENT_PROVIDER. Stripe today; replaced
# by the Egyptian provider's checkout token once PAYMENT_PROVIDER switches.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ---- Monitoring -----------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=

# ---- Local development only ------------------------------------------------------
# The legacy in-frontend mock API (app/api/*) is 410-gated in production.
# Never set this in a deployed environment.
ENABLE_FRONTEND_MOCK_API=
