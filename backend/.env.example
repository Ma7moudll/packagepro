# ---- Server -----------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# Public URL of the Next.js frontend, used for CORS and email links.
FRONTEND_URL=http://localhost:3001
# Set to "true" when the API sits behind a reverse proxy (nginx, ALB, ...).
TRUST_PROXY=false

# ---- Data -------------------------------------------------------------------
# Required in every environment. Production boots refuse to start without them.
DATABASE_URL=postgresql://user:password@localhost:5432/packagepro
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=true

# ---- Auth -------------------------------------------------------------------
# REQUIRED in production: the server throws at boot when either is missing.
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_COST=12
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=128
EMAIL_VERIFICATION_TOKEN_EXPIRES_IN=86400000
PASSWORD_RESET_TOKEN_EXPIRES_IN=3600000
MAX_FAILED_LOGIN_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_MS=3600000

# ---- Payments ----------------------------------------------------------------
# Active payment provider: stripe | fawry | instapay | vodafone_cash | bank_transfer
# Keep "stripe" until an Egyptian merchant account is live (see below).
PAYMENT_PROVIDER=stripe
# ISO 4217 currency for new payments, lowercase. Switch to "egp" with the
# Egyptian providers (Stripe test mode can also charge EGP).
DEFAULT_CURRENCY=usd
# Default VAT applied to every quote/order when the caller passes no explicit
# rate. Egyptian VAT is 14% -> 0.14. Unset or 0 keeps prices tax-free.
DEFAULT_TAX_RATE=

# Stripe (active today)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Fawry (needs a merchant account at fawry.com)
# FAWRY_MERCHANT_CODE=
# FAWRY_SECURITY_KEY=
# FAWRY_BASE_URL=https://atfawry.fawrystaging.com   # sandbox; drop for prod

# InstaPay (needs InstaPay business onboarding)
# INSTAPAY_MERCHANT_ID=
# INSTAPAY_API_KEY=

# Vodafone Cash (needs a merchant wallet)
# VODAFONE_CASH_MERCHANT_ID=
# VODAFONE_CASH_API_KEY=

# Bank transfer (offline flow; no API keys)
# BANK_TRANSFER_ACCOUNT_DETAILS=Bank name / IBAN / account holder shown to the customer

# ---- Shipping ----------------------------------------------------------------
# Active carrier: dhl | bosta | aramex
SHIPPING_PROVIDER=dhl

# DHL (active today)
DHL_API_KEY=
DHL_API_SECRET=
DHL_ACCOUNT_NUMBER=
DHL_BASE_URL=https://api.dhl.com

# Bosta (needs a business account at bosta.co)
# BOSTA_API_KEY=

# Aramex Egypt (needs an Aramex business account)
# ARAMEX_USERNAME=
# ARAMEX_PASSWORD=
# ARAMEX_ACCOUNT_NUMBER=
# ARAMEX_ACCOUNT_ENTITY=
# ARAMEX_ACCOUNT_COUNTRY_CODE=

# ---- Email -------------------------------------------------------------------
# smtp | sendgrid | ses
EMAIL_PROVIDER=smtp
EMAIL_FROM=no-reply@packagepro.example
EMAIL_FROM_NAME=PackagePro
# SENDGRID_API_KEY=
# AWS_SES_ACCESS_KEY_ID=
# AWS_SES_SECRET_ACCESS_KEY=
# AWS_SES_REGION=

# ---- Files -------------------------------------------------------------------
# Local disk when unset; set all four to move uploads to S3-compatible storage.
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
CDN_URL=

# ---- Misc --------------------------------------------------------------------
EXCHANGE_RATE_API_URL=
