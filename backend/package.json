{
  "name": "packagepro-backend",
  "version": "1.0.0",
  "description": "PackagePro Backend API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts",
    "admin:bootstrap": "tsx scripts/bootstrap-admin.ts",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "pricing:bootstrap:egp": "node dist/scripts/bootstrap-egp.js"
  },
  "keywords": [
    "packagepro",
    "packaging",
    "api"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.490.0",
    "@aws-sdk/s3-request-presigner": "^3.490.0",
    "@fastify/cors": "^11.4.3",
    "@fastify/rate-limit": "^10.3.0",
    "@prisma/client": "^5.9.1",
    "axios": "^1.6.5",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.4.1",
    "dotenv": "^16.4.1",
    "fastify": "^5.12.8",
    "fastify-raw-body": "^5.0.0",
    "handlebars": "^4.7.8",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.15.3",
    "nodemailer": "^10.6.1",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.14.0",
    "pg": "^8.16.3",
    "sharp": "^0.35.5",
    "stripe": "^14.9.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^7.0.5",
    "@types/pdfkit": "^0.13.4",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "eslint": "^8.56.0",
    "prettier": "^3.2.4",
    "prisma": "^5.9.1",
    "supertest": "^7.2.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
