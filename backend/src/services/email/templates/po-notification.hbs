<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>Purchase Order</title>
</head>
<body>
  <h1>New Purchase Order</h1>
  <p>You have received a new purchase order.</p>
  <p><strong>PO Number:</strong> {{po.poNumber}}</p>
