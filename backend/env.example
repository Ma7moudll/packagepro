# Database
DATABASE_URL="postgresql://user:password@localhost:5432/packagepro?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="your-secret-key-change-in-production"
JWT_REFRESH_SECRET="your-refresh-secret-key-change-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Auth - Password & Security
BCRYPT_COST=12
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=128

# Auth - Login Security (Exponential Backoff + CAPTCHA)
MAX_LOGIN_ATTEMPTS_BEFORE_CAPTCHA=3
LOGIN_ATTEMPT_BACKOFF_MULTIPLIER=2
LOGIN_ATTEMPT_INITIAL_DELAY_MS=1000
LOGIN_ATTEMPT_MAX_DELAY_MS=16000

# Auth - reCAPTCHA v3
RECAPTCHA_SECRET_KEY="your-recaptcha-secret-key"
RECAPTCHA_RISK_SCORE_THRESHOLD=0.5

# Auth - Email Verification
EMAIL_VERIFICATION_TOKEN_EXPIRES_IN="24h"
VERIFICATION_ATTEMPT_RATE_LIMIT_WINDOW_MS=3600000
VERIFICATION_ATTEMPT_RATE_LIMIT_MAX=5
VERIFICATION_RESEND_COOLDOWN_MS=60000

# Auth - Password Reset
PASSWORD_RESET_TOKEN_EXPIRES_IN="1h"
PASSWORD_RESET_ATTEMPT_RATE_LIMIT_WINDOW_MS=3600000
PASSWORD_RESET_ATTEMPT_RATE_LIMIT_MAX=5

# Auth - Audit Logging
AUDIT_LOG_RETENTION_DAYS=180

# Server
PORT=3000
NODE_ENV=development
FRONTEND_URL="http://localhost:3001"
BACKEND_URL="http://localhost:3000"

# AWS S3 / CloudFlare R2
S3_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_ACCESS_KEY_ID="your-access-key"
S3_SECRET_ACCESS_KEY="your-secret-key"
S3_BUCKET_NAME="packagepro-files"
CDN_URL="https://cdn.packagepro.com"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# DHL Express
DHL_API_KEY="your-dhl-api-key"
DHL_API_SECRET="your-dhl-api-secret"
DHL_ACCOUNT_NUMBER="your-dhl-account-number"
DHL_BASE_URL="https://api.dhl.com"

# Google Maps
GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# Email (SendGrid or AWS SES)
EMAIL_PROVIDER="sendgrid"
SENDGRID_API_KEY="SG..."
AWS_SES_REGION="us-east-1"
AWS_SES_ACCESS_KEY_ID=""
AWS_SES_SECRET_ACCESS_KEY=""
EMAIL_FROM="noreply@packagepro.com"
EMAIL_FROM_NAME="PackagePro"

# Analytics
MIXPANEL_TOKEN=""
POSTHOG_API_KEY=""
POSTHOG_HOST="https://app.posthog.com"

# Monitoring
SENTRY_DSN=""

# Exchange Rate API
EXCHANGE_RATE_API_KEY=""
EXCHANGE_RATE_API_URL="https://api.exchangerate-api.com/v4"
